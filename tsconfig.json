{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "provider/**/*",
    "deploy/**/*",
    "remove/**/*",
    "invoke/**/*",
    "jwt/**/*",
    "logs/**/*",
    "info/**/*",
    "shared/**/*"
  ],
  "exclude": ["node_modules", "dist", "coverage", "tests", "examples"]
}
